# Preferire npm run setup:init per preparare segreti casuali in .env.production.local.
# Copia in .env.local per sviluppo, .env per Docker. Non committare credenziali.
APP_MODE=live
APP_URL=https://mandat.swiss
NEXT_TELEMETRY_DISABLED=1
DATABASE_URL=postgresql://mandat:CHANGE_ME@db:5432/mandat
DATABASE_PROVIDER=local
COMPOSE_FILE=compose.yml
# Per Supabase: client della stessa versione maggiore del database o successiva.
DATABASE_CLIENT_IMAGE=postgres:17-bookworm
DATABASE_POOL_MAX=3
QUEUE_POOL_MAX=3
# Supabase: progetto dedicato Free, regione specifica Zurigo. Copiare l'URL
# Direct/Session porta 5432 da Connect, senza parametri URI; mai NEXT_PUBLIC_.
SUPABASE_PROJECT_REF=
SUPABASE_REGION=eu-central-2
# CA pubblica PEM scaricata dal progetto, codificata base64 se richiesta.
# TLS e verifica del server sono sempre obbligatori con Supabase.
DATABASE_SSL_CA_BASE64=
POSTGRES_USER=mandat
POSTGRES_DB=mandat
POSTGRES_PASSWORD=CHANGE_ME
# Generare almeno 32 byte casuali (43 caratteri base64url). Nessuna chiave predefinita.
BETTER_AUTH_SECRET=
FOUNDER_EMAIL=
FOUNDER_NAME=Fondatore Mandat
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Mandat <radar@mandat.swiss>
INFOMANIAK_AI_PRODUCT_ID=
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=mistralai/Ministral-3-14B-Instruct-2512
AI_MONTHLY_BUDGET_CHF=40
# Inserire prezzi verificati, IVA/commissioni incluse per il tetto effettivo.
# Senza tariffe l'AI resta sospesa e richiede revisione manuale.
LLM_INPUT_CHF_PER_MILLION=
LLM_OUTPUT_CHF_PER_MILLION=
# Attivare solo dopo conferma delle condizioni di riutilizzo del Foglio TI.
FOGLIO_REUSE_CONFIRMED=false
DOMAIN=mandat.swiss
# Swiss Backup: repository fuori dal VPS, credenziali separate e backup in CH.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
