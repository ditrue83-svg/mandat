# Preferire npm run setup:init per preparare segreti casuali in .env.production.local.
# Copia in .env.local per sviluppo, .env per Docker. Non committare credenziali.
APP_MODE=live
APP_URL=https://mandat-app.com
NEXT_TELEMETRY_DISABLED=1
DATABASE_URL=postgresql://mandat:CHANGE_ME@db:5432/mandat
DATABASE_PROVIDER=local
COMPOSE_FILE=compose.yml
# Per Supabase: client della stessa versione maggiore del database o successiva.
DATABASE_CLIENT_IMAGE=postgres:17-bookworm
DATABASE_POOL_MAX=3
QUEUE_POOL_MAX=3
# Supabase: progetto dedicato Free, regione specifica Zurigo. Copiare l'URL
# Direct/Session porta 5432 da Connect, senza parametri URI; mai NEXT_PUBLIC_.
SUPABASE_PROJECT_REF=
SUPABASE_REGION=eu-central-2
# CA pubblica PEM scaricata dal progetto, codificata base64 se richiesta.
# TLS e verifica del server sono sempre obbligatori con Supabase.
DATABASE_SSL_CA_BASE64=
POSTGRES_USER=mandat
POSTGRES_DB=mandat
POSTGRES_PASSWORD=CHANGE_ME
# Generare almeno 32 byte casuali (43 caratteri base64url). Nessuna chiave predefinita.
BETTER_AUTH_SECRET=
FOUNDER_EMAIL=
FOUNDER_NAME=Fondatore Mandat
# Aruba: posta in Italia, porta 465 TLS. Infomaniak CH: mail.infomaniak.com, 587 STARTTLS.
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=
# Usare setup:smtp-password per preservare i caratteri speciali in tutti i runtime.
# Base64 non cifra la password: custodire il file con permessi 0600.
SMTP_PASSWORD_BASE64=
SMTP_PASSWORD=
MAIL_FROM=Mandat <info@mandat-app.com>
# Supported providers: infomaniak (legacy default), mistral-eu, anthropic, openai.
LLM_PROVIDER=infomaniak
INFOMANIAK_AI_PRODUCT_ID=
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=mistralai/Ministral-3-14B-Instruct-2512
# Leave empty for the provider default, or set none/low/medium/high.
LLM_REASONING_EFFORT=
# Mistral has a separate key, never reuses LLM_API_KEY or LLM_API_BASE_URL.
# Only this regional endpoint is accepted, no global fallback or redirects.
MISTRAL_API_KEY=
MISTRAL_API_BASE_URL=https://api.eu.mistral.ai/v1
# Dedicated native providers; keys and endpoints are never inherited.
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.anthropic.com/v1
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
# Luna: DOCUMENTARY_LLM_PROVIDER=openai, DOCUMENTARY_LLM_MODEL=gpt-6-luna.
# Set both documentary reasoning settings explicitly for a quality evaluation.
# Standard API endpoint: no Swiss/EU residency guarantee. store=false is not ZDR.
# Base USD rates as of 2026-09-26: 0.10/M input, 0.50/M output.
# Configure CHF rates with exchange/tax/fee margin; input is also multiplied
# by 1.25 in the ledger to cover any cache writes (cache discounts ignored).
# Requests over 200KB are rejected before spending to avoid long-input pricing.
# https://developers.openai.com/api/docs/models/gpt-6-luna
# To migrate only documentary reading/review/comparison: set
# DOCUMENTARY_LLM_PROVIDER=mistral-eu and DOCUMENTARY_LLM_MODEL=mistral-large-2512.
# Use reasoning=none (omitted from Mistral requests) and dedicated CHF prices.
# Regional list price is USD 0.55/M input, 1.65/M output (2026-09-24), not CHF.
# Verify conversion, tax/fees and API training opt-out before activation.
# https://docs.mistral.ai/inference/regional-inference
# Optional comparison-specific provider/model; dedicated prices required.
# Existing summaries keep LLM_MODEL and its rates.
DOCUMENTARY_LLM_PROVIDER=
DOCUMENTARY_LLM_MODEL=
DOCUMENTARY_LLM_REASONING_EFFORT=
# Source interpretation only; never inherits the comparison/legacy setting.
# Infomaniak: none disables thinking; low/medium/high all enable it.
# https://developer.infomaniak.com/docs/api/post/2/ai/%7Bproduct_id%7D/openai/v1/chat/completions
# Keeps 8192 output tokens. This default is not a semantic-quality attestation.
DOCUMENTARY_SOURCE_REASONING_EFFORT=none
DOCUMENTARY_LLM_INPUT_CHF_PER_MILLION=
DOCUMENTARY_LLM_OUTPUT_CHF_PER_MILLION=
AI_MONTHLY_BUDGET_CHF=10
# Confronto documentario: attivare dopo la verifica del nuovo modello/contratto.
# Non abilita l'invio automatico delle email, che conserva il proprio gate.
DOCUMENTARY_COMPARISON_ENABLED=false
# Inserire prezzi verificati, IVA/commissioni incluse per il tetto effettivo.
# Senza tariffe l'AI resta sospesa e richiede revisione manuale.
LLM_INPUT_CHF_PER_MILLION=
LLM_OUTPUT_CHF_PER_MILLION=
# Attivare solo dopo conferma delle condizioni di riutilizzo del Foglio TI.
FOGLIO_REUSE_CONFIRMED=false
# Adozione lotti: lasciare assente fino al rilascio coordinato dei consumer.
# Il file contiene l'attestazione del rilascio, montata in sola lettura nel worker.
# Un file assente, invalido o con build incompatibile impedisce l'avvio se la
# variabile è impostata. Non inserire questo valore nei payload dei job.
# MANDAT_DOCUMENTARY_RELEASE_FILE=/run/mandat/documentary-release.json
DOMAIN=mandat-app.com
# Swiss Backup: repository fuori dal VPS, credenziali separate e backup in CH.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
