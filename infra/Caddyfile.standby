www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	header {
		Content-Type "text/html; charset=utf-8"
		Cache-Control "no-store"
		-Server
	}
	respond <<HTML
		<!doctype html>
		<html lang="it">
		<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="robots" content="noindex, nofollow">
		<title>Mandat — in preparazione</title>
		<style>
		*{box-sizing:border-box}body{margin:0;min-height:100svh;display:grid;place-items:center;background:#f6f7f4;color:#183c38;font:18px/1.6 system-ui,sans-serif;padding:24px}main{max-width:560px;width:100%;padding:clamp(28px,7vw,56px);background:white;border:1px solid #dce5df;border-radius:24px}h1{font-size:clamp(36px,8vw,52px);letter-spacing:-2px;line-height:1.1;margin:0 0 32px}h2{font-size:24px;line-height:1.3;margin:0 0 16px}p{color:#4c615a;margin:0}
		</style>
		</head>
		<body><main><h1>Mandat</h1><h2>Stiamo preparando il Radar.</h2><p>Il servizio è in fase di configurazione e non è ancora disponibile.</p></main></body>
		</html>
		HTML 503
}
